# IdeaLens — Environment Variables
# Copy this file to .env and fill in your API keys

# Groq API (LLM inference) — free tier at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Tavily API (web search) — free tier at app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Jina Reader API (web content extraction) — free at jina.ai/reader
# Without this key, requests share a strict IP-wide rate limit
JINA_API_KEY=your_jina_api_key_here
